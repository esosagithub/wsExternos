    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">FAC_CLIENTE_TELEFONO</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">DepartmentCode</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">FAC_DEPARTAMEN_CODE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">DepartmentName</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">FAC_DEPARTAMEN_NAME</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ProvinceCode</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">FAC_PROVINCIA_CODE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ProvinceName</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">FAC_PROVINCIA_NAME</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">DistrictCode</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No se envia en BillingAddress para RUC.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">DistrictName</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No se envia en BillingAddress para RUC.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="29">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">StreetName / StreetNumber / PostalCode / SecondaryStreet</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB / Fijo</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">CLIENTE_DIRECION / CLIENTE_DIRECION2 / Vacio / Vacio</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">StreetName usa CLIENTE_DIRECION; StreetNumber usa CLIENTE_DIRECION2; PostalCode y SecondaryStreet van vacios.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">BillingAddress</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Reference</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">CLEINTE_REFERENCIA</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">Orderdiscounts</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">Orderdiscounts</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No se genera en PiHeader. Los descuentos se documentan y envian por linea en PtItems.item.PromotionEntries.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">Orderdiscounts</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionCode</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Este campo no se envia en Orderdiscounts; se envia en PromotionEntries cuando DESCUENTO &gt; 0.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">Orderdiscounts</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionName</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Este campo no se envia en Orderdiscounts; se envia en PromotionEntries cuando DESCUENTO &gt; 0.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">Orderdiscounts</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionType</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Este campo no se envia en Orderdiscounts; se envia en PromotionEntries cuando DESCUENTO &gt; 0.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">Orderdiscounts</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionGroup</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Este campo no se envia en Orderdiscounts; se envia en PromotionEntries cuando DESCUENTO &gt; 0.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">Orderdiscounts</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">TotalDiscount</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No aplica</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No generado</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">El valor de linea se envia en PtItems.item.TotalDiscount. Si hay DESCUENTO usa DESCUENTO * CANTIDAD; si no, usa TotalPrice.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">item</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">PEDIDO_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se genera un item por cada linea de detalle del pedido, excepto las lineas cuyo CODIGO inicia con 600. Si existe una linea 600, se excluye de PtItems y se genera DeliveryDetails.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">LineNumber</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">LINEA</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Numero.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">ProductCode</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">CODIGO</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Unit</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">UNIDAD_MEDIDA</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">BaseItemPrice</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">PRECIO / PRECIO_ORIGINAL</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Si DESCUENTO &gt; 0 usa PRECIO_ORIGINAL; si no, usa PRECIO con 2 decimales.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">TotaItemPrice</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">PRECIO</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Si DESCUENTO &gt; 0 usa PRECIO sin forzar 2 decimales; si no, usa PRECIO con 2 decimales. Etiqueta actual sin letra l por requerimiento previo.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">NumberOfItems</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">CANTIDAD</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Numero.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">TotalPrice</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">CANTIDAD * TotaItemPrice</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Multiplica NumberOfItems por TotaItemPrice y envia el resultado con 2 decimales.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PtItems.item</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">TotalDiscount</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">DESCUENTO * CANTIDAD / TotalPrice</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Si DESCUENTO &gt; 0 multiplica DESCUENTO por NumberOfItems y envia el resultado con 2 decimales. Si DESCUENTO es 0, usa el mismo valor de TotalPrice.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PromotionEntries</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionEntries</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">DESCUENTO</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Si DESCUENTO &gt; 0 se generan los campos de promocion dentro de PromotionEntries. Si no, PromotionEntries queda vacio.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PromotionEntries</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionCode / PromotionName</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">PROMOTION_CODE / NOMBRE_PROMO</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Solo si DESCUENTO &gt; 0. PromotionCode usa PROMOTION_CODE; PromotionName usa NOMBRE_PROMO.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="29">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PromotionEntries</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionType / PromotionGroup / IsEmployeePromotion / Description / CouponCode</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE / Fijo</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">PROMOTION_TYPE / PROMOTION_GROUP / false / NOMBRE_PROMO / vacio</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Solo si DESCUENTO &gt; 0. CouponCode se envia vacio.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s63"><Data ss:Type="String">PromotionEntries</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">DiscountAmount</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB_DETALLE</Data></Cell>
   <Cell ss:StyleID="s64"><Data ss:Type="String">DESCUENTO * CANTIDAD</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Solo si DESCUENTO &gt; 0. Multiplica DESCUENTO por NumberOfItems y envia el resultado con 2 decimales.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">GiftWrappings</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">GiftWrappings</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Fijo</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Vacio</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se genera siempre vacio.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s63"><Data ss:Type="String">CustomDetails</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">CustomDetails</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Fijo</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Vacio</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se genera siempre vacio.</Data></Cell>
   </Row>
  </Table>
