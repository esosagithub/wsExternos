    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">CLIENTE_NOMBRE</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Texto directo. Si FAC_CLIENTE_TIPO = RUC, se envia vacio.</Data></Cell>
