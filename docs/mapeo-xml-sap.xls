    <Cell ss:StyleID="s64"><Data ss:Type="String">PhoneNumber</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">VENTAS_WEB / Fijo</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">PICKUP_NUMBER / Vacio</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Para RETIRO EN TIENDA se envia vacio. Para lineas 600 sin retiro en tienda, se toma de PICKUP_NUMBER.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
