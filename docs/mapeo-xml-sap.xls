 <Worksheet ss:Name="Condicionantes">
  <Table ss:ExpandedColumnCount="2" ss:ExpandedRowCount="10" x:FullColumns="1"
   x:FullRows="1" ss:DefaultColumnWidth="60" ss:DefaultRowHeight="14.5">
   <Column ss:Width="240"/>
   <Column ss:Width="520"/>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s62"><Data ss:Type="String">Seccion / Tag</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Condicion actual</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s64"><Data ss:Type="String">Orderdiscounts</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">No se genera en PiHeader. Los descuentos se manejan por linea en PtItems.item cuando VENTAS_WEB_DETALLE.DESCUENTO &gt; 0.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s64"><Data ss:Type="String">DeliveryDetails.IsPickupInStore</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">true si VENTAS_WEB.TIPO_ENTREGA = RETIRO EN TIENDA. DeliveryDetails se genera si TIPO_ENTREGA = RETIRO EN TIENDA o si existe una linea cuyo CODIGO inicia con 600.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
   <Cell ss:StyleID="s64"><Data ss:Type="String">PtItems.item</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se genera un item por cada registro en VENTAS_WEB_DETALLE asociado al PEDIDO_WEB, excepto registros cuyo CODIGO inicia con 600. Estos se excluyen de PtItems y, si existen, generan DeliveryDetails. RETIRO EN TIENDA tambien genera DeliveryDetails aunque no exista linea 600.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s64"><Data ss:Type="String">PromotionEntries</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se llena solo si la linea tiene VENTAS_WEB_DETALLE.DESCUENTO &gt; 0. Los campos de promocion quedan dentro de PromotionEntries sin bloque item interno; si no hay descuento, PromotionEntries queda vacio.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s64"><Data ss:Type="String">Pagos</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Actualmente el XML toma solo la primera fila de VENTAS_WEB_PAGOS.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s64"><Data ss:Type="String">Valores NULL de texto</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se envian como cadena vacia.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s64"><Data ss:Type="String">Valores NULL monetarios</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Actualmente se envian como 0.00 por la funcion money().</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s64"><Data ss:Type="String">GiftWrappings / CustomDetails</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se generan siempre vacios.</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="29">
    <Cell ss:StyleID="s64"><Data ss:Type="String">PaypalPaymentInfo / PayuPaymentInfo / EcPaymentInfo / CreditNotePaymentInfo</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Se generan siempre.</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Unsynced/>
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>1</SplitHorizontal>
   <TopRowBottomPane>1</TopRowBottomPane>
   <ActivePane>2</ActivePane>
   <Panes>
    <Pane>
     <Number>3</Number>
    </Pane>
    <Pane>
     <Number>2</Number>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
